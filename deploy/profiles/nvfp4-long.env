# 500K total context; preserve qualified scheduler sizes while validating cache reuse.
MAX_MODEL_LEN=500000
YARN_ENABLE=true
YARN_FACTOR=2
MAX_NUM_SEQS=3
MAX_NUM_BATCHED_TOKENS=8192
QWEN_PREFIX_CACHE=true
QWEN_REQUEST_TELEMETRY=true
EXTRA_VLLM_ARGS="--enable-prefix-caching --mamba-cache-mode align"
