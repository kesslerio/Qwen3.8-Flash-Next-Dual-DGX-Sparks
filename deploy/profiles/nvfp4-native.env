# 262K x 6, MTP3 -- native profile (no YaRN).
#
# Sits below nvfp4-mid (500K x 6, YaRN) on the context-vs-concurrency axis.
# 262K keeps the per-sequence KV budget small so 6-way MTP3 stays
# memory-bandwidth-bound on decode (the fast path).
#
# Prefix caching is ON so shared system/tool prefixes are counted once,
# lowering real usage below the naive sum. The common profile defaults
# --no-enable-prefix-caching / QWEN_PREFIX_CACHE=false; the profile is
# sourced AFTER the common profile, so these overrides take effect. The
# YaRN guard re-forces YaRN off only at <= 262144, so 262144 stays
# YaRN-off exactly as intended.
MAX_MODEL_LEN=262144
YARN_ENABLE=false
MAX_NUM_SEQS=6
QWEN_PREFIX_CACHE=true
EXTRA_VLLM_ARGS="--enable-prefix-caching --mamba-cache-mode align"
