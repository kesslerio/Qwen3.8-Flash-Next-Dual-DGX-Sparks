[Unit]
Description=Qwen request metadata history (seven days, no prompt content)
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=kesslerio
Group=docker
# `%h` resolves to the configured service user's home directory.
Environment=HOME=%h
UMask=0077
ExecStart=/usr/bin/python3 %h/Qwen3.8-Flash-Next-Dual-DGX-Sparks/deploy/request_history.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/qwen-cluster

[Install]
WantedBy=multi-user.target
