[Unit]
Description=Qwen3.8 Flash Next NVFP4 two-node cluster supervisor
After=network-online.target docker.service roce-ip.service
Wants=network-online.target
Requires=docker.service
# Keep retrying after a prolonged worker outage, with the cooldown below.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=kesslerio
Group=docker
Environment=HOME=/home/kesslerio
EnvironmentFile=/home/kesslerio/.config/qwen-cluster/active.env
WorkingDirectory=/home/kesslerio/Qwen3.8-Flash-Next-Dual-DGX-Sparks
ExecStart=/usr/bin/python3 /home/kesslerio/Qwen3.8-Flash-Next-Dual-DGX-Sparks/deploy/qwen_cluster_supervisor.py
Restart=on-failure
RestartSec=300
TimeoutStartSec=6600
TimeoutStopSec=180
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
